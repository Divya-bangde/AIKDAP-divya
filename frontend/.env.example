# Base ORIGIN of the API — scheme + host + port only.
#
# Do NOT include `/api/v1`. Every service module already passes the
# full versioned path (`request("/api/v1/auth/login")`), and
# `services/client.ts` builds the URL as `${VITE_API_BASE_URL}${path}`.
# Adding the prefix here produces `/api/v1/api/v1/...` and 404s.
#
# LOCAL: verified against the running backend (docker-compose.yml maps
# the backend container's port 8000 to host port 8001).
VITE_API_BASE_URL=http://localhost:8001

# PRODUCTION / same-origin deployments (e.g. Vercel, where the API is
# served from the same hostname as the frontend): leave this EMPTY or
# unset. `client.ts` falls back to "", so requests become relative
# (`/api/v1/auth/login`) and hit whatever backend that origin routes
# `/api/*` to. Setting it to a localhost URL in a hosted build is
# always wrong — the visitor's browser, not your machine, resolves it.
#
# Only set a value in production if the API lives on a DIFFERENT origin
# from the frontend, in which case use that public HTTPS origin (again
# without `/api/v1`) and add it to the backend's BACKEND_CORS_ORIGINS.
#
# VITE_* variables are inlined at BUILD time, so changing this in a
# hosting dashboard requires a redeploy before it takes effect.

# Optional: research-run polling interval in milliseconds.
VITE_RESEARCH_POLL_INTERVAL_MS=1500
